# Configuração local do build_installer.sh — copie para local.env e ajuste.
# local.env não é versionado (contém caminhos da máquina).

# Cópia de build no filesystem do Windows (caminho Windows, sem barra final).
# Nunca aponte para \\wsl.localhost\... — quebra nos symlinks de plugin.
DECIMA_WINBUILD_DIR='C:\Users\SEU_USUARIO\decima-winbuild'

# Compilador do Inno Setup 6.2+ no host.
DECIMA_ISCC='C:\Program Files (x86)\Inno Setup 6\ISCC.exe'

# Comando do Flutter no host. Use 'fvm flutter' se a cópia tiver .fvmrc,
# ou 'flutter' para o SDK global.
DECIMA_FLUTTER='fvm flutter'
